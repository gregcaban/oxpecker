#!/bin/sh
# Runs the Java harness with the JDK Rhino needs. Build first: (cd harness-java && ./gradlew fatJar)
JAVA="${OXPECKER_JAVA:-/usr/local/opt/openjdk@21/bin/java}"
LIBS="$(dirname "$0")/../harness-java/build/libs"
# OXPECKER_RHINO=NAME runs the harness built for that Rhino target (oxpecker build-harness NAME,
# rhino-targets.toml). Unset, or the default target without a jar of its own: the plain fatJar.
JAR="$LIBS/oxpecker-harness-all.jar"
if [ -n "$OXPECKER_RHINO" ]; then
  if [ -f "$LIBS/harness-$OXPECKER_RHINO.jar" ]; then
    JAR="$LIBS/harness-$OXPECKER_RHINO.jar"
  elif ! grep -q "^default = \"$OXPECKER_RHINO\"" "$(dirname "$0")/../rhino-targets.toml"; then
    echo "no harness jar for Rhino target $OXPECKER_RHINO; build it: oxpecker build-harness $OXPECKER_RHINO" >&2
    exit 2
  fi
fi
AGENT=""
# OXPECKER_COVERAGE=1 attaches the JaCoCo agent so the harness can report which Rhino code each
# case reached (coverage buckets, `oxpecker ... --coverage`). Generated script classes are excluded.
if [ -n "$OXPECKER_COVERAGE" ]; then
  AGENT="-javaagent:$LIBS/jacocoagent.jar=output=none,includes=org.mozilla.javascript.*,excludes=org.mozilla.javascript.gen.*"
fi
exec "$JAVA" -Xss64m $AGENT -jar "$JAR" "$@"
